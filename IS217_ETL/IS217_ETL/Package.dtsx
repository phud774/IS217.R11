            <component
              refId="Package\Load DIM_STORE\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH RankedStore AS
(
    SELECT
        LTRIM(RTRIM(store_no)) AS store_no,
        NULLIF(LTRIM(RTRIM(store_name)), '') AS store_name,

        MAX(NULLIF(LTRIM(RTRIM(store_city)), ''))
            OVER (PARTITION BY LTRIM(RTRIM(store_no)))
            AS store_city,

        MAX(NULLIF(LTRIM(RTRIM(county_name)), ''))
            OVER (PARTITION BY LTRIM(RTRIM(store_no)))
            AS county_name,

        ROW_NUMBER() OVER
        (
            PARTITION BY LTRIM(RTRIM(store_no))
            ORDER BY
                TRY_CONVERT(date, ordered_on) DESC,
                invoice_id DESC
        ) AS row_num
    FROM stg.LiquorSalesRaw
    WHERE NULLIF(LTRIM(RTRIM(store_no)), '') IS NOT NULL
)
SELECT
    store_no,
    store_name,
    store_city,
    county_name
FROM RankedStore AS source_store
WHERE row_num = 1
  AND NOT EXISTS
  (
      SELECT 1
      FROM dbo.DIM_STORE AS existing_store
      WHERE existing_store.store_no = source_store.store_no
  );</property>
                <property
