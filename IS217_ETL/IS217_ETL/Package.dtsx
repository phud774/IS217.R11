    <DTS:Executable
      DTS:refId="Package\Load DIM_DATE"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1E1A7612-A4AF-49F2-9CDF-0679668CFB69}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load DIM_DATE"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{85FD3DE2-F8BF-4A1B-92FC-2DD1F461F8F1}"
          SQLTask:SqlStatementSource=";WITH CalendarDates AS&#xA;(&#xA;    SELECT CAST('2024-01-01' AS date) AS calendar_date&#xA;&#xA;    UNION ALL&#xA;&#xA;    SELECT DATEADD(day, 1, calendar_date)&#xA;    FROM CalendarDates&#xA;    WHERE calendar_date &lt; '2024-12-31'&#xA;)&#xA;INSERT INTO dbo.DIM_DATE&#xA;(&#xA;    date_key,&#xA;    ordered_on,&#xA;    day_number,&#xA;    month_number,&#xA;    month_name,&#xA;    quarter_number,&#xA;    year_number&#xA;)&#xA;SELECT&#xA;    CONVERT(int, CONVERT(char(8), calendar_date, 112)),&#xA;    calendar_date,&#xA;    DAY(calendar_date),&#xA;    MONTH(calendar_date),&#xA;    DATENAME(month, calendar_date),&#xA;    DATEPART(quarter, calendar_date),&#xA;    YEAR(calendar_date)&#xA;FROM CalendarDates AS source_date&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.DIM_DATE AS existing_date&#xA;    WHERE existing_date.ordered_on = source_date.calendar_date&#xA;)&#xA;OPTION (MAXRECURSION 366);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
