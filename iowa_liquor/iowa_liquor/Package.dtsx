        <SQLTask:SqlTaskData
          SQLTask:Connection="{8C1530DB-E446-4B78-B080-F17F62FF5445}"
          SQLTask:SqlStatementSource="DELETE FROM dbo.FACT_LIQUOR_SALES;&#xA;&#xA;DELETE FROM dbo.DIM_VENDOR;&#xA;DELETE FROM dbo.DIM_PRODUCT;&#xA;DELETE FROM dbo.DIM_STORE;&#xA;DELETE FROM dbo.DIM_DATE;&#xA;&#xA;DBCC CHECKIDENT ('dbo.FACT_LIQUOR_SALES', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.DIM_VENDOR', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.DIM_PRODUCT', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.DIM_STORE', RESEED, 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
