          SQLTask:SqlStatementSource="IF DB_ID('IowaLiquorDW') IS NULL&#xA;BEGIN&#xA;    EXEC('CREATE DATABASE IowaLiquorDW');&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
